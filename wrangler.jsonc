{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "manzi-mfa-2",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  // Requis par `wrangler preview` (commande de déploiement preview Workers Builds).
  "previews": {},
  // Prod : manzi-mfa-2.mongulu.cm ; previews : <nom-branche>.manzi-mfa-2.mongulu.cm
  // (Cloudflare crée le wildcard DNS + certificat quand previews_enabled est actif).
  "routes": [
    {
      "pattern": "manzi-mfa-2.mongulu.cm",
      "custom_domain": true,
      // Sert la production ET les previews (<nom-preview>.manzi-mfa-2.mongulu.cm).
      "previews_enabled": true
    }
  ]
}
