{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration-schema.json",
  "name": "manzi-mfa-2-app",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public" },
  "observability": { "enabled": true },
  // Cloudflare Email Service : notifications Quick Chat (F-008), sans clé d'API.
  "send_email": [{ "name": "EMAIL" }],
  "workers_dev": true,
  "previews": {},
  "routes": [
    {
      "pattern": "app.manzi-mfa-2.mongulu.cm",
      "custom_domain": true,
      "previews_enabled": true
    }
  ]
}
