# Les secrets restent côté serveur dans runtimeConfig.
# Seules les valeurs publiques utilisent NUXT_PUBLIC_*.
# En local, exporter ces variables dans les deux terminaux (voir README.md).
# NUXT_PUBLIC_APP_URL : origine HTTP(S) uniquement, sans sous-chemin (ex. https://app.example.com).
NUXT_PUBLIC_APP_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SUPABASE_URL=https://gdcirvvqangyraxauggy.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Notifications Quick Chat (F-008), serveur uniquement. provider : log (défaut, n'envoie rien) ou cloudflare.
NUXT_NOTIFICATIONS_PROVIDER=log
# Origine des liens des emails ; jamais déduite de la requête.
NUXT_NOTIFICATIONS_APP_URL=http://localhost:3001
NUXT_NOTIFICATIONS_FROM_EMAIL=
NUXT_NOTIFICATIONS_FROM_NAME=Manzi-mfa
NUXT_NOTIFICATIONS_REPLY_TO=collectif@mongulu.cm
NUXT_NOTIFICATIONS_TIME_ZONE=Africa/Douala
# Politique JSON facultative ; vide : création et modification envoyées au mentor et au mentoré.
NUXT_NOTIFICATIONS_POLICY=
# Clé Supabase de type secret (sb_secret_…), jamais service_role ; secret Cloudflare, jamais committé.
NUXT_SUPABASE_SECRET_KEY=
# Smoke email réel (npm run test:email) uniquement, jamais dans la CI ; valeurs dans .env ignoré.
E2E_EMAIL_TO=
# Facultatif : boîte du mentor ; à défaut, alias +mentor de E2E_EMAIL_TO.
E2E_EMAIL_TO_MENTOR=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# Test LinkedIn réel uniquement, jamais dans la CI ; conserver les valeurs dans .env ignoré.
E2E_LINKEDIN_USERNAME=
E2E_LINKEDIN_PASSWORD=
# Production : les valeurs par défaut de chaque nuxt.config.ts visent les domaines publics.
# Previews : remplacer ces valeurs par les URL correspondantes des deux Workers.
