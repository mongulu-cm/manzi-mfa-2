{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Points d'entrée Nuxt : le graphe suit les imports depuis ces fichiers.
  "entry": [
    "apps/*/nuxt.config.ts",
    "apps/*/app/app.vue",
    "apps/*/app/assets/css/*.css",
    "layers/*/nuxt.config.ts",
    "layers/*/stories/**/*.stories.ts",
    "apps/*/stories/**/*.stories.ts",
    "tests/e2e/*.test.mjs",
    "tests/db/run.mjs",
    "tests/smoke/linkedin.mjs",
    "tests/smoke/email.smoke.ts",
    "vitest.config.ts",
    "vitest.unit.config.ts",
    "vitest.smoke.config.ts"
  ],
  "ignorePatterns": [
    ".storybook/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.wrangler/**",
    "storybook-static/**",
    "node_modules/**",
    "**/public/**"
  ],
  "duplicates": {
    // Tolérance zéro : chaque paire dupliquée est rapportée.
    "minOccurrences": 2
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  // Usages réels invisibles à l'analyse statique :
  // - @storybook/addon-a11y et @storybook-vue/nuxt : référencés dans .storybook/,
  //   exclu du graphe applicatif.
  // - storybook : importé via le sous-chemin 'storybook/test' dans les stories
  // - vue : fourni au runtime par Nuxt, importé directement seulement dans les stories.
  // - vue-tsc : chargé dynamiquement par `nuxt typecheck` dans @nuxt/cli.
  // - @supabase/server : dépendance déjà ajoutée par l’utilisateur, conservée pour
  //   le futur backend ; cette intégration SPA utilise supabase-js côté navigateur.
  "ignoreDependencies": [
    "@storybook/addon-a11y",
    "@storybook-vue/nuxt",
    "@supabase/server",
    "@tanstack/intent",
    "storybook",
    "vue",
    "vue-tsc"
  ]
}
