{
  "name": "manzi-mfa-2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "npm run dev:vitrine",
    "dev:vitrine": "npm run dev --workspace @manzi/vitrine",
    "dev:app": "npm run dev --workspace @manzi/plateforme",
    "build": "npm run build:vitrine && npm run build:app",
    "build:vitrine": "npm run build --workspace @manzi/vitrine",
    "build:app": "npm run build --workspace @manzi/plateforme",
    "generate": "npm run generate --workspace @manzi/vitrine",
    "preview": "npm run preview:vitrine",
    "preview:vitrine": "npm run preview --workspace @manzi/vitrine",
    "preview:app": "npm run preview --workspace @manzi/plateforme",
    "deploy": "npm run deploy:vitrine",
    "deploy:vitrine": "npm run deploy --workspace @manzi/vitrine",
    "deploy:app": "npm run deploy --workspace @manzi/plateforme",
    "deploy:preview:app": "npm run deploy:preview --workspace @manzi/plateforme",
    "postinstall": "npm run prepare --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "node tests/db/run.mjs",
    "test:linkedin": "node tests/smoke/linkedin.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@nuxt/ui": "^4.11.3",
    "@supabase/server": "^1.9.0",
    "nuxt": "4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@storybook-vue/nuxt": "^10.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/vue3": "^10.6.1",
    "@supabase/supabase-js": "2.117.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "fallow": "^3.31.0",
    "playwright": "1.63.0",
    "playwright-core": "^1.63.0",
    "storybook": "^10.6.1",
    "supabase": "2.120.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.145.0"
  },
  "workspaces": [
    "apps/*",
    "layers/*"
  ]
}
